{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "framework": "fastapi",
            "entrypoint": "main:app",
            "functions": {
                "main.py": {
                    "maxDuration": 300,
                    "includeFiles": [
                        "models/Kuku-Anemia/core/models/seg_runtime/cnn_hb_resnet18_v2.*",
                        "models/Kuku-Anemia/core/models/seg_runtime/elasticnet_model.joblib",
                        "models/Kuku-Anemia/yolo26n-seg.pt",
                        "models/Deploy_AnemiaEyes/deploy/outputs/models/**",
                        "models/Kuku-Anemia/experiments/yolo26_seg/runs/seg26/weights/best.pt",
                        "models/Kuku-Anemia/experiments/yolo26_seg/runs/seg26/weights/last.pt",
                        "models/Kuku-Anemia/core/assets/hand_landmarker.task",
                        "models/Kuku-Anemia/core/models/**"
                    ]
                }
            },
            "env": {
                "ANEVIA_SEG26_WEIGHTS": "models/Kuku-Anemia/experiments/yolo26_seg/runs/seg26/weights/best.pt"
            }
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}